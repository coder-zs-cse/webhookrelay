# Copy to deploy/.env on the server (it is gitignored). Never commit real values.

# Public hostname, no scheme. Its DNS A record must point at the server before first start,
# or Caddy cannot get a certificate. No domain yet? Use <elastic-ip-with-dashes>.sslip.io
DOMAIN=relay.example.com

# Neon DIRECT connection string (host without "-pooler"), with ?sslmode=require.
# Direct is needed because `prisma migrate deploy` does not work through a pooler.
DATABASE_URL=

# openssl rand -hex 32
JWT_SECRET=
